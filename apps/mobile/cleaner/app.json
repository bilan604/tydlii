{
  "expo": {
    "name": "Tydlii Cleaner",
    "slug": "tydlii-cleaner",
    "owner": "tydlii",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tydlii-cleaner",
    "userInterfaceStyle": "light",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tydlii.cleaner",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tydlii uses your location only during an active job so the customer can follow the visit. Tracking stops when the job is done."
      }
    },
    "android": {
      "package": "com.tydlii.cleaner",
      "versionCode": 1,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#04a3ac",
          "defaultChannel": "job-status",
          "mode": "development",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/wordmark-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#070707"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
