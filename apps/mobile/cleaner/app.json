{
  "expo": {
    "name": "Tydlii Cleaner",
    "slug": "tydlii-cleaner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tydlii-cleaner",
    "userInterfaceStyle": "light",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tydlii.cleaner"
    },
    "android": {
      "package": "com.tydlii.cleaner",
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/wordmark-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#070707"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
