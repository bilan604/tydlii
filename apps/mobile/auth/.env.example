# Copy the lines you need into apps/mobile/customer/.env or apps/mobile/cleaner/.env.
# Leave them empty. CI does not read this file. Do not commit the filled-in file.
# Do not put a Google client secret, an Apple .p8, or EXPO_TOKEN here.

# Generic hosted provider. Both must be set or the apps stay on the device form.
# This pair does not create a session. Google and Apple below do.
EXPO_PUBLIC_AUTH_ISSUER=
EXPO_PUBLIC_AUTH_CLIENT_ID=

# Google OAuth client ids (Google Cloud → Credentials → OAuth client ID).
# They look like 123456789012-abc.apps.googleusercontent.com. A placeholder is ignored.
# No client secret. Create one client per platform, per app (customer and cleaner).
# iOS: bundle id com.tydlii.customer or com.tydlii.cleaner.
#   Redirect: com.googleusercontent.apps.<prefix>:/oauth2redirect
# Android: package name as above, plus the SHA-1 from EAS credentials later.
#   Same reversed-client redirect. Expo Go cannot register that scheme.
# Web: add the site origin, often http://localhost:8081/auth/callback
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Apple. iOS uses the bundle id already in app.json and needs no Services ID.
# Android and web need a Services ID and an https return URL (localhost http is
# accepted for the web preview only). Do not commit a Sign in with Apple key.
# EXPO_PUBLIC_APPLE_SERVICE_ID=
# EXPO_PUBLIC_APPLE_REDIRECT_URI=

# Expo project UUIDs already exist on account tydlii. Do not run eas init.
# Paste the UUID for the app you are running into its gitignored .env.
# Customer app (apps/mobile/customer), Expo @tydlii/tydlii-customer:
#   ed30d1f1-b1a8-479f-8309-a8ebd04a4cbe
# Cleaner app (apps/mobile/cleaner), Expo @tydlii/tydlii-cleaner:
#   26014761-9e69-40e9-bc62-f71e1aa8e5fe
# app.config.ts copies EXPO_PUBLIC_EAS_PROJECT_ID into extra.eas.projectId when
# that value is a UUID, and otherwise keeps the id committed in app.json.
# Do not commit EXPO_TOKEN.
# EXPO_PUBLIC_EAS_PROJECT_ID=
