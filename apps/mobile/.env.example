# Copy to apps/mobile/customer/.env for a local Expo run.
# Do not commit that file. Nothing here is required for CI or the web preview.
# The live visit map is MapLibre on OpenStreetMap tiles. It does not take a maps key.

# Stripe test mode only. Live keys are refused by the payment stub.
# This placeholder does not talk to Stripe. Replace it with a pk_test_ key from the
# Stripe dashboard after the founder account exists. Do not put a secret key here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tydlii_placeholder
