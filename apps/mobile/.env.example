# Customer app only. Copy to apps/mobile/customer/.env for a local Expo run.
# Do not commit that file. Expo inlines EXPO_PUBLIC_* into the JS bundle.
#
# Leave the placeholder to run the PaymentSheet stand-in. It does not call Stripe,
# does not create a PaymentIntent, and does not charge a card.
#
# When a Stripe test account exists, replace the value with that account's
# publishable key (Dashboard → Developers → API keys → Publishable key, test mode).
# pk_live_ is refused and the sheet will not open. Do not put a secret key (sk_) here.
# The customer development, preview, and production EAS profiles also stay on this
# placeholder until you change them on purpose. Still use pk_test_ only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tydlii_placeholder

# Maps: unused. Live visit is MapLibre drawing free OpenStreetMap tiles.
# Do not set a Google, Mapbox, or other paid maps key. EXPO_PUBLIC_MAPS_API_KEY is ignored.

# Push. The Expo projects already exist on account tydlii. Do not run eas init.
# Paste this app's UUID into the gitignored .env as EXPO_PUBLIC_EAS_PROJECT_ID.
# Customer app (apps/mobile/customer), Expo @tydlii/tydlii-customer:
#   ed30d1f1-b1a8-479f-8309-a8ebd04a4cbe
# Cleaner app (apps/mobile/cleaner), Expo @tydlii/tydlii-cleaner:
#   26014761-9e69-40e9-bc62-f71e1aa8e5fe
# When EXPO_PUBLIC_EAS_PROJECT_ID is unset, push reads extra.eas.projectId from
# app.json. Do not commit EXPO_TOKEN or other secrets.
# EXPO_PUBLIC_PUSH_REGISTER_URL is an https endpoint that will store the device
# token. While it is unset, the token is not sent. No APNs key, FCM key, or
# Expo access token belongs in this file. The access token stays on the server.
# EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_PUBLIC_PUSH_REGISTER_URL=

# Google and Apple client ids live in apps/mobile/auth/.env.example.
# Copy those names into this same .env. Leave them empty. Do not paste a client secret.
