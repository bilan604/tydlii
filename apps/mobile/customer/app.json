{
  "expo": {
    "name": "Tydlii",
    "slug": "tydlii-customer",
    "owner": "tydlii",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tydlii-customer",
    "userInterfaceStyle": "light",
    "backgroundColor": "#070707",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tydlii.customer",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tydlii.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#04a3ac",
          "defaultChannel": "job-status",
          "mode": "development",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/wordmark-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#070707"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "ed30d1f1-b1a8-479f-8309-a8ebd04a4cbe"
      }
    }
  }
}
