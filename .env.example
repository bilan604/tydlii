# Public Web3Forms access key for teamtydlii@gmail.com.
# The browser posts signups to https://api.web3forms.com/submit.
# Next.js inlines this into the client bundle at build time, so set it before
# `npm run build` or a Render redeploy. The key is meant to be public.
# Do not commit the value.
NEXT_PUBLIC_WAITLIST_WEB3FORMS_ACCESS_KEY=

# Optional fallback. The homepage reads this on the server when the public
# variable is empty and passes it to the form. The server does not call Web3Forms.
WAITLIST_WEB3FORMS_ACCESS_KEY=

# Optional. POST /api/waitlist forwards the JSON here after validation.
# Failures are logged and do not fail the signup. The form does not depend on it.
# A Google Apps Script /exec URL is a poor target: it answers 302, and the follow-up fails.
WAITLIST_WEBHOOK_URL=
