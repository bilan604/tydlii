# Web3Forms access key for the team inbox (teamtydlii@gmail.com).
# Create it at https://web3forms.com. When set, POST /api/waitlist emails that inbox.
# When unset outside production, the server logs the signup and returns 200.
# When unset in production, the server logs the signup and returns 500.
# Do not commit the key.
WAITLIST_WEB3FORMS_ACCESS_KEY=

# Optional. After Web3Forms accepts the signup, POST the JSON here.
# Failures are logged and do not fail the signup.
# Use an https endpoint you control. A Google Apps Script /exec URL is a poor target:
# it answers 302, and the follow-up request fails.
WAITLIST_WEBHOOK_URL=
